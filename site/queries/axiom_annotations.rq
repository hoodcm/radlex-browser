# Annotations on reified annotation axioms of the scoped classes, such as a synonym's type.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?c ?p ?t ?q ?v WHERE {
  ?ax a owl:Axiom ;
      owl:annotatedSource ?c ;
      owl:annotatedProperty ?p ;
      owl:annotatedTarget ?t ;
      ?q ?v .
  %SCOPE(?c)%
  FILTER(?q NOT IN (rdf:type, owl:annotatedSource, owl:annotatedProperty, owl:annotatedTarget))
}
